+/// auth.json 里是否有可用的 ChatGPT 登录凭据。旧版 Codex 写入的 auth.json
+/// 没有 `auth_mode` 字段，所以只看 `tokens`。
+fn auth_contents_has_chatgpt_login(contents: &str) -> bool {
+    serde_json::from_str::<Value>(contents)
+        .ok()
+        .and_then(|value| value.get("tokens").map(tokens_have_login_secret))
+        .unwrap_or(false)
+}
