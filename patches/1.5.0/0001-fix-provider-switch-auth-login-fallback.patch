+/// Ubuntu 补丁：官方混合 API（`Official` + `official_mix_api_key`）与 `MixedApi`
+/// 切换时写入 live 的 auth.json。
+///
+/// 上游会一律剥掉 `OPENAI_API_KEY`，依赖「ChatGPT OAuth 登录态 + provider 的
+/// `experimental_bearer_token`」。但只用 API Key、从未登录 ChatGPT 的用户，
+/// auth.json 剥完就只剩空内容，配合 `requires_openai_auth = true`，Codex 判定
+/// 未登录，打开时直接进入登录页而不是对话界面。
+///
+/// 规则：存在 ChatGPT 登录凭据时保持上游行为；否则把中转 Key 写回
+/// `OPENAI_API_KEY`，让 Codex 以 API Key 身份直接进入对话（请求仍由 provider
+/// 的 `experimental_bearer_token` 发往中转站，二者是同一个 Key）。
+fn mixed_profile_auth_for_switch(home: &Path, profile: &RelayProfile) -> anyhow::Result<String> {
+    let auth_contents = official_profile_auth_for_switch(home, &profile.auth_contents)?;
+    let mixed_mode = profile.relay_mode == RelayMode::MixedApi
+        || (profile.relay_mode == RelayMode::Official && profile.official_mix_api_key);
+    if !mixed_mode || auth_contents_has_chatgpt_login(&auth_contents) {
+        return Ok(auth_contents);
+    }
+    let api_key = relay_profile_api_key(profile);
+    if api_key.trim().is_empty() {
+        return Ok(auth_contents);
+    }
+    // auth_contents 已由 official_profile_auth_for_switch 校验为合法 JSON 对象或空串。
+    let merged = set_openai_api_key_in_auth_contents(&auth_contents, &api_key)?;
+    Ok(format!("{merged}\n"))
+}
