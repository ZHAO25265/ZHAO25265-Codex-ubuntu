+        switch_relay_profile_in_home(&store, &home, back_to_pure, "mix-provider").unwrap();
+
+    let saved_mix = switched_back
+        .settings
+        .relay_profiles
+        .iter()
+        .find(|item| item.id == "mix-provider")
+        .expect("mix-provider 应存在");
+    assert_eq!(saved_mix.relay_mode, RelayMode::Official);
+    assert!(
+        saved_mix.official_mix_api_key,
+        "切回后 backfill 不能冲掉 official_mix_api_key"
+    );
+    assert_eq!(saved_mix.api_key, "sk-mix-key");
+
+    let live_auth_on_pure: serde_json::Value =
+        serde_json::from_str(&std::fs::read_to_string(home.join("auth.json")).unwrap()).unwrap();
+    assert_eq!(
+        live_auth_on_pure
+            .get("OPENAI_API_KEY")
+            .and_then(|item| item.as_str()),
+        Some("sk-pure-key")
+    );
+}
