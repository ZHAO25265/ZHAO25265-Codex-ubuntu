+/// Ubuntu 补丁：launcher 启动时若 live `auth.json` 为空（例如此前切换供应商时被清空），
+/// 且当前激活供应商拥有有效凭据，则仅补写 `auth.json` 而不触碰 `config.toml`。
+pub fn repair_missing_live_auth_for_active_profile(
+    home: &Path,
+    profile: &RelayProfile,
+) -> anyhow::Result<bool> {
+    if !home.join("config.toml").exists() {
+        return Ok(false);
+    }
+    let auth_path = home.join("auth.json");
+    let current_auth = std::fs::read_to_string(&auth_path).unwrap_or_default();
+    let has_api_key = serde_json::from_str::<Value>(&current_auth)
+        .ok()
+        .and_then(|value| {
+            value
+                .get("OPENAI_API_KEY")
+                .and_then(|item| item.as_str())
+                .map(|key| !key.trim().is_empty())
+        })
+        .unwrap_or(false);
+    if auth_contents_has_chatgpt_login(&current_auth) || has_api_key {
+        return Ok(false);
+    }
+    let repaired = match profile.relay_mode {
+        crate::settings::RelayMode::PureApi => {
+            if !profile.auth_contents.trim().is_empty() {
+                profile.auth_contents.clone()
+            } else {
+                let api_key = relay_profile_api_key(profile);
+                if api_key.trim().is_empty() {
+                    String::new()
+                } else {
+                    format!(
+                        "{}\n",
+                        set_openai_api_key_in_auth_contents(&current_auth, &api_key)?
+                    )
+                }
+            }
+        }
+        crate::settings::RelayMode::Aggregate => auth_contents_with_proxy_key(
+            home,
+            &profile.auth_contents,
+            &relay_profile_api_key(profile),
+        )?,
+        crate::settings::RelayMode::Official | crate::settings::RelayMode::MixedApi => {
+            mixed_profile_auth_for_switch(home, profile)?
+        }
+    };
+    if repaired.trim().is_empty() {
+        return Ok(false);
+    }
+    crate::settings::atomic_write(&auth_path, repaired.as_bytes())?;
+    let _ = crate::diagnostic_log::append_diagnostic_log(
+        "launcher.live_auth_repaired",
+        serde_json::json!({
+            "relay_id": profile.id,
+            "relay_mode": format!("{:?}", profile.relay_mode),
+        }),
+    );
+    Ok(true)
+}
